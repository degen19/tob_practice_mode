[clientscript,tob_supplies_tabs](int $selected)
def_component $tab0 = tob_supplies:tab0;
def_component $tab1 = tob_supplies:tab1;
def_component $tab2 = tob_supplies:tab2;
def_component $tab3 = tob_supplies:tab3;
def_component $active = null;
if ($selected = 0) {
    $active = $tab0;
} else if ($selected = 1) {
    $active = $tab1;
} else if ($selected = 2) {
    $active = $tab2;
} else if ($selected = 3) {
    $active = $tab3;
}
~button_setup($active, $tab0, "Runes");
~button_setup($active, $tab1, "Gear");
~button_setup($active, $tab2, "Ammo");
~button_setup($active, $tab3, "Supplies");
