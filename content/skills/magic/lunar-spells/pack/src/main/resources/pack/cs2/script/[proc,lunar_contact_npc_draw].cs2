[proc,lunar_contact_npc_draw](component $component)
// This world's Astral Contact list: Washer (contact 1) and TM 19 (contact 2). The heads are
// borrowed from the Honest Jimmy and Dark Mage rows of the npc_contact table.
cc_deleteall($component);
def_int $count = 0;
def_int $int12 = 0;
def_string $string = "";
def_dbrow $look = null;
def_int $contact = 0;
def_int $int7 = 65;
def_int $int8 = 125;
def_int $int9 = 35;
while ($count < 2) {
    if ($count = 0) {
        $string = "Washer";
        $look = npc_contact_honest_jimmy;
        $contact = 1;
    } else {
        $string = "TM 19";
        $look = npc_contact_dark_mage;
        $contact = 2;
    }
    cc_create($component, ^iftype_layer, $int12);
    cc_setsize($int7, $int8, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc($count * 67), 0, ^setpos_abs_left, ^setpos_abs_top);
    cc_setonmouseover("lunar_contact_text_mouseover($component, $int12)");
    cc_setonmouseleave("lunar_contact_text_mouseleave($component, $int12)");
    cc_setop(1, "Contact <col=ff981f><$string>");
    cc_setonop("lunar_contact_op($contact, event_op)");
    $int12 = calc($int12 + 1);
    cc_create_child(^iftype_model, $int12);
    cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setmodel(db_getfield($look, npc_contact:head_model, 0));
    cc_setmodelangle(0, 0, 0, db_getfield($look, npc_contact:y_angle, 0), 0, max(400, db_getfield($look, npc_contact:zoom, 0)));
    $int12 = calc($int12 + 1);
    cc_create_sibling(^iftype_text, $int12);
    cc_setsize($int7, $int9, ^setsize_abs, ^setsize_abs);
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom);
    cc_settext($string);
    cc_settextfont(p12_full);
    cc_settextshadow(true);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_setcolour(0xff981f);
    $int12 = calc($int12 + 1);
    $count = calc($count + 1);
}
